# Environment Variables Template - Profile-Wide Agent
# Copy to .env and fill in your values

# GitHub Configuration
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username

# AI API Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# Get at: https://makersuite.google.com/app/apikey

# X (Twitter) OAuth 1.0a Credentials
# Get from: https://developer.twitter.com → Your App → Keys and Tokens
X_CONSUMER_KEY=your_consumer_key_here
X_CONSUMER_SECRET=your_consumer_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# For local testing only
GITHUB_EVENT_PATH=examples/test_event_pr.json
